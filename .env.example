# Supabase (public — safe to expose to the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI engine — any OpenAI-compatible endpoint.
#   Local dev:   LLM_BASE_URL=http://localhost:11434/v1  (Ollama)
#   Production:  e.g. https://api.groq.com/openai/v1 + LLM_API_KEY
# Leave unset to run in demo mode (sample output, clearly labeled).
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Service-role key (Supabase project settings → API). Server-only, never
# NEXT_PUBLIC_*. Powers the rate limiter and every ops agent.
SUPABASE_SERVICE_ROLE_KEY=

# --- Ops agents (/admin, /api/agents/run) ---
# Shared secret the GitHub Actions cron sends to trigger a scheduled agent run.
AGENT_CRON_SECRET=
# Telegram bot (via @BotFather) the agents page/ping when something needs you.
NOTIFY_TELEGRAM_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=
# The one email allowed to view /admin.
ADMIN_EMAIL=

# --- Job Match (live job search) ---
# All sources are optional. With NONE set, Job Match still works via the two
# zero-auth feeds (Arbeitnow + Remotive) — €0, no signup.
#
# Adzuna: free tier, email-only signup, NO card. Unlocks the country dropdown
# (~20 countries) + keyword/date filters. https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
#
# JSearch (RapidAPI): FREE tier ~200 req/month, free key, NO card. Best free
# quality — Google-for-Jobs coverage incl. big companies. https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=
#
# Apify (fantastic-jobs ATS API): PAID (pay-per-result). Reserved for PREMIUM
# members only — set the emails allowed to spend it below. Server-only.
APIFY_TOKEN=
# Comma-separated emails allowed to use paid sources (Apify). Empty = nobody.
PREMIUM_EMAILS=
# Per-search Apify item cap (cost = ~$0.012/item). Default 25.
JOBS_APIFY_MAX=25
#
# Background refresh cost guards (optional; sane defaults in code).
JOBS_REFRESH_MAX_USERS=25
JOBS_REFRESH_REFINE_TOP=3
# The /api/jobs/refresh cron reuses AGENT_CRON_SECRET (above) as its x-agent-secret.
